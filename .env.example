# Copy file này thành .env rồi điền thông tin. KHÔNG commit file .env.
#
# Không có file .env: email KHÔNG gửi ra ngoài mà được lưu lại, xem tại
# http://127.0.0.1:8000/dev/mailbox/ (dùng để test trên máy dev).
#
# Gmail: bật Xác minh 2 bước, sau đó tạo "Mật khẩu ứng dụng" (App password) tại
# https://myaccount.google.com/apppasswords và dán 16 ký tự vào EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.account@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
