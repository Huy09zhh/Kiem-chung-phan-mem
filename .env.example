# Copy file này thành .env nếu chưa có, rồi điền thông tin. KHÔNG commit file .env.
# Hướng dẫn: docs/SMTP_SETUP.md
#
# Không có file .env: email KHÔNG gửi ra ngoài mà được lưu lại, xem tại
# http://127.0.0.1:8000/dev/mailbox/ khi DEBUG=True; chỉ superuser đang hoạt động
# được xem/xóa hộp thư. Người chưa đăng nhập, customer và staff không có quyền.
#
# Gmail: bật Xác minh 2 bước, sau đó tạo "Mật khẩu ứng dụng" (App password) tại
# https://myaccount.google.com/apppasswords và dán 16 ký tự vào EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Tùy chọn: dùng cùng địa chỉ với EMAIL_HOST_USER sau khi cấu hình SMTP.
# DEFAULT_FROM_EMAIL=Green Shop <your.account@gmail.com>
