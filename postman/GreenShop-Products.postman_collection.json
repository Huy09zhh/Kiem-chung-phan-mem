    "name": "Green Shop - Products & Search (TC-PS-001 -> TC-PS-010)",
    "description": "Bộ kiểm thử tự động API Phân hệ 2 - Products & Search (Đỗ Văn Huy).\nGồm 10 ca kiểm thử từ TC-PS-001 đến TC-PS-010.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Danh sách sản phẩm (TC-PS-001 -> TC-PS-003)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"[TC-PS-001] Lấy danh sách tất cả sản phẩm (Status 200 OK)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"[TC-PS-002] Thời gian tải trang danh sách sản phẩm (< 500ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "pm.test(\"[TC-PS-003] Kiểm tra giao diện có đúng tiêu đề ('Tất cả sản phẩm')\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Tất cả sản phẩm\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Gợi ý tìm kiếm tức thì (TC-PS-004 -> TC-PS-006)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search-suggestions/?q=cây",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "search-suggestions",
            ""
          ],
          "query": [
            {
              "key": "q",
              "value": "cây"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"[TC-PS-004] Tìm kiếm sản phẩm theo từ khóa 'cây' (Status 200 OK)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"[TC-PS-005] Tốc độ tìm kiếm gợi ý (< 500ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "pm.test(\"[TC-PS-006] Kiểm tra định dạng dữ liệu trả về (JSON chứa 'Cây Sen Đá Mini')\", function () {",
              "    pm.response.to.be.json;",
              "    pm.expect(pm.response.text()).to.include(\"Cây Sen Đá Mini\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Chi tiết sản phẩm hợp lệ (TC-PS-007 -> TC-PS-009)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/1/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
